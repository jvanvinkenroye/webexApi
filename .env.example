# Bot-Token (läuft nie ab, für automatisierte Nachrichten)
WEBEX_TOKEN=<bot-token-hier>

# OAuth Integration (für Personal Token mit automatischer Erneuerung)
# Integration anlegen: https://developer.webex.com/my-apps/new/integration
# Redirect URI: http://localhost:8080/callback
# Scopes: spark:messages_write spark:rooms_read spark:people_read
WEBEX_CLIENT_ID=<client-id>
WEBEX_CLIENT_SECRET=<client-secret>
